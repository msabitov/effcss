{
    "name": "effcss",
    "version": "5.4.5",
    "description": "Self-confident CSS-in-TS",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "coverage:submit": "vitest run --coverage && coveralls < ./coverage/lcov.info"
    },
    "keywords": [
        "ui",
        "user interface",
        "front-end",
        "typescript",
        "css",
        "css-in-js",
        "css-in-ts"
    ],
    "author": "Marat Sabitov",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "coveralls": "^3.1.1",
        "playwright": "^1.50.1",
        "rollup": "^4.59.0",
        "rollup-plugin-cleaner": "^1.0.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "files": [
        "LICENSE",
        "README.md",
        "package.json",
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/msabitov/effcss"
    },
    "homepage": "https://effnd.tech/css/"
}
