{
    "name": "effcss",
    "version": "6.0.1",
    "description": "Self-confident CSS-in-TS",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "rollup -c",
        "test": "vitest --project browser --project node",
        "coverage": "vitest run --coverage --project browser --project node",
        "coverage:submit": "vitest run --coverage --project browser --project node && coveralls < ./coverage/lcov.info",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "bench:size": "node bench/size.mjs",
        "bench:time": "vitest bench --project bench"
    },
    "keywords": [
        "ui",
        "user interface",
        "front-end",
        "typescript",
        "css",
        "css-in-js",
        "css-in-ts"
    ],
    "author": "Marat Sabitov",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "coveralls": "^3.1.1",
        "playwright": "^1.50.1",
        "prettier": "^3.9.9",
        "rollup": "^4.59.0",
        "rollup-plugin-cleaner": "^1.0.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "files": [
        "LICENSE",
        "README.md",
        "package.json",
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/msabitov/effcss"
    },
    "homepage": "https://effnd.tech/css/"
}
